rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    // Keep the public site readable, but require Firebase Auth for admin writes.
    match /experience/{docId} {
      allow read: if true;
      allow create, update, delete: if isSignedIn();
    }

    match /projects/{docId} {
      allow read: if true;
      allow create, update, delete: if isSignedIn();
    }

    match /skills/{docId} {
      allow read: if true;
      allow create, update, delete: if isSignedIn();
    }

    match /{document=**} {
      allow read: if true;
      allow write: if false;
    }
  }
}
